{% doc %}
Renders the floating WhatsApp chat button.

@param {string} [phone] - WhatsApp number in international format without the plus sign.
@param {string} [message] - Prefilled chat message.
{% enddoc %}

{%- assign whatsapp_phone = phone | default: '8758871805' -%}
{%- assign whatsapp_message = message | default: 'Hi TAVAS, I need help with an order.' -%}

<a class="whatsapp-button" href="https://wa.me/91{{ whatsapp_phone }}?text={{ whatsapp_message | url_encode }}" aria-label="{{ 'general.whatsapp' | t }}" title="{{ 'general.whatsapp' | t }}" target="_blank" rel="noopener">
