<section class="section">
  <div class="container">
    <div class="section__heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="rte">{{ section.settings.text }}</div>
    </div>

    <div class="grid-cards grid-cards--four">
      <div class="main-content-card">
        <p class="eyebrow">{{ section.settings.prop_1_label }}</p>
        <h3>{{ section.settings.prop_1_title }}</h3>
        <div class="rte">{{ section.settings.prop_1_text }}</div>
      </div>
      <div class="main-content-card">
        <p class="eyebrow">{{ section.settings.prop_2_label }}</p>
        <h3>{{ section.settings.prop_2_title }}</h3>
        <div class="rte">{{ section.settings.prop_2_text }}</div>
      </div>
      <div class="main-content-card">
        <p class="eyebrow">{{ section.settings.prop_3_label }}</p>
        <h3>{{ section.settings.prop_3_title }}</h3>
        <div class="rte">{{ section.settings.prop_3_text }}</div>
      </div>
      <div class="main-content-card">
        <p class="eyebrow">{{ section.settings.prop_4_label }}</p>
        <h3>{{ section.settings.prop_4_title }}</h3>
        <div class="rte">{{ section.settings.prop_4_text }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why TAVAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A quiet store that still sells."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Minimal design, helpful support and clear value.</p>"
    },
    {
      "type": "text",
      "id": "prop_1_label",
      "label": "Label 1",
      "default": "Style"
    },
    {
      "type": "text",
      "id": "prop_1_title",
      "label": "Title 1",
      "default": "Old money minimal"
    },
    {
      "type": "richtext",
      "id": "prop_1_text",
      "label": "Text 1",
      "default": "<p>Soft colours and clean layouts that feel premium without shouting.</p>"
    },
    {
      "type": "text",
      "id": "prop_2_label",
      "label": "Label 2",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "prop_2_title",
      "label": "Title 2",
      "default": "Affordable everyday picks"
    },
    {
      "type": "richtext",
      "id": "prop_2_text",
      "label": "Text 2",
      "default": "<p>We keep the buying decision simple with value-focused edits.</p>"
    },
    {
      "type": "text",
      "id": "prop_3_label",
      "label": "Label 3",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "prop_3_title",
      "label": "Title 3",
      "default": "WhatsApp help"
    },
    {
      "type": "richtext",
      "id": "prop_3_text",
      "label": "Text 3",
      "default": "<p>Fast support through a single chat button on every page.</p>"
    },
    {
      "type": "text",
      "id": "prop_4_label",
      "label": "Label 4",
      "default": "Range"
    },
    {
      "type": "text",
      "id": "prop_4_title",
      "label": "Title 4",
      "default": "Built for daily wear"
    },
    {
      "type": "richtext",
      "id": "prop_4_text",
      "label": "Text 4",
      "default": "<p>Pieces you can actually wear often, not just once.</p>"
    }
  ]
}
{% endschema %}
