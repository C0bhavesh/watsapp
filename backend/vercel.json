{
  "builds": [{ "src": "api/index.py", "use": "@vercel/python" }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "regions": ["bom1"],
  "crons": [
    { "path": "/internal/jobs/outbox_drain", "schedule": "* * * * *" },
    { "path": "/internal/jobs/send_reminders", "schedule": "*/5 * * * *" }
  ]
}
