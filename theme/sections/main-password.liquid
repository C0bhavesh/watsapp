<section class="section">
  <div class="container">
    <div class="main-content-card">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1>{{ 'password.heading' | t }}</h1>
      <p>{{ 'password.text' | t }}</p>
      {% form 'storefront_password' %}
        <div class="field">
          <label for="Password">{{ 'password.label' | t }}</label>
          <input id="Password" type="password" name="password">
        </div>
        <button class="button" type="submit">{{ 'password.button' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
