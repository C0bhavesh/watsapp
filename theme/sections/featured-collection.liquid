<section class="section">
  <div class="container">
    <div class="section__heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
      </div>
      {%- if section.settings.collection != blank and section.settings.button_label != blank -%}
        <a class="button button--ghost" href="{{ section.settings.collection.url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <div class="product-grid">
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="main-content-card">
        <p>{{ 'featured_collection.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Picked for everyday wear."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Focus on clean fits, accessible pricing and repeat wear.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
