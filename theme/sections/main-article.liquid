<section class="section">
  <div class="container">
    <article class="main-content-card">
      <p class="eyebrow">{{ article.blog.title }}</p>
      <h1>{{ article.title }}</h1>
      {%- if article.image != blank -%}
        <div style="margin:1rem 0;border-radius:16px;overflow:hidden">
          {{ article.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: article.title }}
        </div>
      {%- endif -%}
      <div class="rte">{{ article.content }}</div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
