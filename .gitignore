# Secrets & local env — never commit
.env
.env.*
*.pem

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Vercel / Node
.vercel/
node_modules/

# Claude local settings
.claude/settings.local.json

# Git worktrees + SDD scratch workspaces (never repo content)
.claude/worktrees/
.superpowers/

# uv lockfile — let Vercel's own uv version generate it at build time
# (avoids a lock-format mismatch between local uv and Vercel's older uv).
backend/uv.lock
backend/.vercel/
